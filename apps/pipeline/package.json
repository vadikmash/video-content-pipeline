{
  "name": "@vcp/pipeline",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./stages": "./src/stages/index.ts",
    "./store": "./src/store/index.ts"
  },
  "scripts": {
    "dev": "concurrently -k -n serve,inngest -c blue,magenta \"tsx watch --env-file-if-exists=../../.env src/server.ts\" \"inngest-cli dev -u http://localhost:3001/api/inngest --no-discovery\"",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "test": "vitest run --exclude test/e2e.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vcp/core": "workspace:*",
    "@vcp/db": "workspace:*",
    "@vcp/limits": "workspace:*",
    "@vcp/providers": "workspace:*",
    "@vcp/renderer": "workspace:*",
    "inngest": "^4.26.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.540",
    "@vcp/provider-fake-publish": "workspace:*",
    "@vcp/provider-blob-local": "workspace:*",
    "concurrently": "^10.0.6",
    "inngest-cli": "^1.49.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
