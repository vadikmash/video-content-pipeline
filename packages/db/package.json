{
  "name": "@vcp/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "bind": "tsx --env-file-if-exists=../../.env src/bind.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vcp/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
