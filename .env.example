# Postgres (docker-compose.yml)
DATABASE_URL=postgres://vcp:vcp@localhost:5432/vcp

# Local blob store directory (relative paths resolve from the repo root)
BLOB_DIR=.data/blobs

# Inngest: local dev server, no signing key needed
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288

# Remotion entry point used by the render-remotion provider
RENDERER_ENTRY=apps/renderer/src/index.ts

# Public URL of the dashboard; blob URLs are built from it
DASHBOARD_URL=http://localhost:3000

# Pipeline serve endpoint port
PIPELINE_PORT=3001

# Real providers (M1). Fakes stay bound until you run `pnpm providers:bind`.
# OPENAI_API_KEY binds TextModel to llm-openai. Set LLM_PROVIDER=anthropic to use Claude instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_PROVIDER=openai

# ElevenLabs. Voice id is stored on the Speech binding by providers:bind.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# YouTube OAuth. `pnpm youtube:auth` prints a refresh token; it does not write this file.
# The OAuth client needs redirect URI http://127.0.0.1:8765/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CATEGORY_ID=27
